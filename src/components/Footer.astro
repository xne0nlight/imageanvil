---
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <Logo size={28} showWordmark={true} />
      <p class="footer-tag">Client-side image tools, forged for the web.</p>
    </div>

    <div class="footer-cols">
      <div class="footer-col">
        <h4 class="footer-heading">Tools</h4>
        <a href="/heic-to-avif">HEIC → AVIF</a>
        <a href="/avif-converter">AVIF Converter</a>
        <a href="/webp-converter">WebP Converter</a>
        <a href="/batch-optimize">Batch Optimizer</a>
      </div>

      <div class="footer-col">
        <h4 class="footer-heading">Project</h4>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
      </div>
    </div>
  </div>

  <div class="container footer-bottom">
    <span class="copyright">© {year} Image Anvil</span>
    <span class="privacy-note">
      <span class="dot" aria-hidden="true"></span>
      Conversions run in your browser. No uploads, no accounts, no tracking.
    </span>
  </div>
</footer>

<style>
  .site-footer { margin-top: 6rem; padding: 4rem 0 2rem; border-top: 1px solid var(--border); background: var(--surface); }
  .footer-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; margin-bottom: 3rem; }
  .footer-brand { max-width: 320px; }
  .footer-tag { margin-top: 1rem; font-size: 0.9375rem; color: var(--text-muted); line-height: 1.5; }
  .footer-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
  .footer-col { display: flex; flex-direction: column; gap: 0.625rem; }
  .footer-heading { font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin-bottom: 0.5rem; }
  .footer-col a { font-size: 0.9375rem; color: var(--text-body); }
  .footer-col a:hover { color: var(--glow); }
  .footer-bottom { padding-top: 2rem; border-top: 1px solid var(--border); display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; align-items: center; font-size: 0.8125rem; color: var(--text-muted); }
  .privacy-note { display: inline-flex; align-items: center; gap: 0.5rem; }
  .dot { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--glow); box-shadow: 0 0 8px rgba(249,115,22,0.5); animation: forgeGlow 2.5s ease-in-out infinite; }
  @media (max-width: 720px) { .footer-inner { grid-template-columns: 1fr; gap: 2.5rem; } .footer-bottom { justify-content: flex-start; } }
</style>
