---
import BaseLayout from '../../layouts/BaseLayout.astro';

const articles = [
  {
    title: 'AVIF vs WebP: Which Format Should You Use in 2026?',
    description: 'A practical comparison of the two leading modern image formats — file sizes, quality, browser support, and when to pick each one.',
    href: '/blog/avif-vs-webp',
    date: 'May 2026',
    readTime: '8 min',
    category: 'Guide',
  },
  {
    title: 'HEIC Files Explained: What They Are and How to Convert Them',
    description: 'Everything you need to know about Apple\'s default photo format — what it is, why it exists, and how to work with it outside the Apple ecosystem.',
    href: '/blog/what-is-heic',
    date: 'May 2026',
    readTime: '6 min',
    category: 'Explainer',
  },
  {
    title: 'How to Optimize Images for Web Performance',
    description: 'A practical workflow for choosing formats, setting quality, sizing responsively, and avoiding the mistakes that tank your page speed.',
    href: '/blog/optimize-images-for-web',
    date: 'May 2026',
    readTime: '9 min',
    category: 'Guide',
  },
];
---

<BaseLayout
  title="Blog"
  description="Guides and explainers on modern image formats, web performance, and practical image optimization. By Image Anvil."
>
  <section class="blog-index">
    <div class="container-narrow">
      <header class="blog-header">
        <span class="badge">Blog</span>
        <h1>Guides & explainers</h1>
        <p class="blog-lead">Practical knowledge about modern image formats, web performance, and getting the most out of your images — from the team behind the tools.</p>
      </header>

      <div class="article-list">
        {articles.map((article) => (
          <a href={article.href} class="article-card">
            <div class="article-card-top">
              <span class="badge">{article.category}</span>
              <span class="article-card-meta mono">{article.date} · {article.readTime}</span>
            </div>
            <h2 class="article-card-title">{article.title}</h2>
            <p class="article-card-desc">{article.description}</p>
            <span class="article-card-link">
              Read article
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 7h12m0 0L7.5 1.5M13 7l-5.5 5.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .blog-index { padding: 4rem 0 2rem; }
  .blog-header { margin-bottom: 3.5rem; }
  .blog-header .badge { margin-bottom: 1.5rem; }
  .blog-header h1 { margin-bottom: 1rem; }
  .blog-lead { font-size: 1.125rem; color: var(--text-muted); line-height: 1.6; max-width: 560px; }

  .article-list { display: flex; flex-direction: column; gap: 1.25rem; }

  .article-card { display: block; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 2rem; text-decoration: none; color: inherit; transition: all 250ms var(--ease); }
  .article-card:hover { border-color: var(--text-max); transform: translateY(-2px); box-shadow: var(--shadow-lg); color: inherit; }
  .article-card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.5rem; }
  .article-card-meta { font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.06em; }
  .article-card-title { font-size: 1.375rem; font-weight: 700; color: var(--text-max); margin-bottom: 0.625rem; letter-spacing: -0.015em; line-height: 1.3; }
  .article-card-desc { font-size: 0.9375rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 1rem; }
  .article-card-link { display: inline-flex; align-items: center; gap: 0.375rem; font-size: 0.875rem; font-weight: 600; color: var(--text-max); transition: gap 200ms var(--ease); }
  .article-card:hover .article-card-link { gap: 0.625rem; color: var(--glow); }
</style>
