---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="HEIC to AVIF Converter"
  description="Convert HEIC (iPhone photos) to AVIF directly in your browser. Smaller files, better quality, client-side privacy. No uploads required."
>
  <!-- Breadcrumb -->
  <nav class="breadcrumb container" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
      <path d="M4 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span aria-current="page">HEIC → AVIF</span>
  </nav>

  <section class="tool-intro">
    <div class="container-narrow">
      <div class="tool-badges">
        <span class="badge">HEIC</span>
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M1 7h12m0 0L7.5 1.5M13 7l-5.5 5.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="badge badge-glow">AVIF</span>
      </div>
      <h1>HEIC to AVIF Converter</h1>
      <p class="tool-lead">
        Convert your iPhone's HEIC photos to AVIF — the modern web's most efficient image format. Smaller files, same quality, and it all happens in your browser.
      </p>
    </div>
  </section>

  <!-- The actual tool -->
  <section class="converter-section">
    <div class="container-narrow">
      <div class="converter" id="converter">

        <!-- Drop zone -->
        <div class="drop-zone" id="dropZone" role="button" tabindex="0" aria-label="Drop HEIC files or click to browse">
          <input type="file" id="fileInput" accept=".heic,.heif,image/heic,image/heif" multiple hidden />

          <div class="drop-zone-content" id="dropZoneContent">
            <div class="drop-icon">
              <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M24 6v28m0 0l-10-10m10 10l10-10M8 42h32" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <h3 class="drop-title">Drop HEIC files here</h3>
            <p class="drop-sub">or <button type="button" class="browse-btn" id="browseBtn">browse to choose</button></p>
            <p class="drop-note">Multiple files supported · Max 50MB each</p>
          </div>
        </div>

        <!-- Settings -->
        <div class="settings" id="settings">
          <div class="setting">
            <label for="quality">Quality</label>
            <div class="quality-row">
              <input type="range" id="quality" min="30" max="95" value="70" step="5" />
              <output for="quality" id="qualityValue" class="mono">70</output>
            </div>
            <p class="setting-hint">
              <strong>50–70</strong> for web. <strong>80+</strong> for archival.
              <strong>Lower = smaller file.</strong>
            </p>
          </div>
        </div>

        <!-- Status overlay (modal-style, hidden until processing) -->
        <div class="status-overlay" id="statusArea" hidden role="dialog" aria-modal="true" aria-labelledby="statusLabel" aria-live="polite">
          <div class="status-modal">
            <div class="forge-animation" aria-hidden="true">
              <div class="forge-anvil">
                <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
                  <path d="M 35 80 L 165 80 L 175 95 L 165 110 L 125 110 L 125 140 L 155 140 L 155 160 L 45 160 L 45 140 L 75 140 L 75 110 L 35 110 Z" fill="currentColor"/>
                </svg>
              </div>
              <div class="forge-pixels">
                <span class="forge-pixel forge-pixel-1"></span>
                <span class="forge-pixel forge-pixel-2"></span>
                <span class="forge-pixel forge-pixel-3"></span>
                <span class="forge-pixel forge-pixel-4"></span>
                <span class="forge-pixel forge-pixel-5"></span>
              </div>
              <div class="forge-glow-bg" aria-hidden="true"></div>
            </div>

            <div class="status-content">
              <span class="status-label" id="statusLabel">Preparing...</span>
              <span class="status-count" id="statusCount"></span>
            </div>

            <div class="progress-bar">
              <div class="progress-fill" id="progressFill"></div>
            </div>

            <p class="status-note">
              Conversion is happening in your browser. Don't close this tab.
            </p>
          </div>
        </div>

        <!-- Results area (hidden until done) -->
        <div class="results" id="results" hidden>
          <div class="results-header">
            <h3>Conversion complete</h3>
            <button type="button" class="btn-text" id="clearBtn">Clear</button>
          </div>
          <ul class="result-list" id="resultList"></ul>
          <button type="button" class="btn btn-primary download-all" id="downloadAllBtn" hidden>
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M7 1v9m0 0l-4-4m4 4l4-4M2 13h10" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Download all as ZIP
          </button>
        </div>

      </div>
    </div>
  </section>

  <!-- SEO content below the tool -->
  <section class="info-section">
    <div class="container-narrow">
      <h2>Why convert HEIC to AVIF?</h2>
      <p>
        HEIC is what your iPhone captures photos in. It's efficient, but outside of Apple's ecosystem it's a pain — Windows, Android, older browsers, and most CMS platforms don't handle it natively. AVIF is the modern web's answer: even smaller file sizes, better quality preservation, and <strong>wide browser support</strong> in Chrome, Firefox, Safari, and Edge.
      </p>

      <h3>When to use AVIF over other formats</h3>
      <p>
        AVIF is your best option for web delivery in 2026. Compared to JPEG, you'll typically see <strong>40-60% smaller files at equivalent quality</strong>. Compared to WebP, AVIF still edges ahead in most real-world tests, particularly for photographic content. Use it for hero images, product photography, galleries, and anywhere page weight matters.
      </p>

      <h3>A note on quality settings</h3>
      <p>
        AVIF is remarkably forgiving. Quality 70 will look indistinguishable from the original to most viewers while cutting file size dramatically. For hero images where every pixel counts, 80 is a safe ceiling. Going above 85 rarely produces visible gains and eats file size benefits.
      </p>

      <h3>Your files stay on your device</h3>
      <p>
        This entire tool runs in your browser using WebAssembly. <strong>Your images are never uploaded to any server.</strong> You can disconnect from the internet after this page loads and the tool still works. That's not a marketing claim — it's how the architecture actually works.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  // ============================================
  // HEIC → AVIF Converter
  // All conversion happens client-side via WASM.
  // ============================================

  // Dynamic imports keep the initial page load fast — the WASM
  // libraries only load when the user actually drops a file.
  async function loadConverters() {
    const [heicToModule, avifModule] = await Promise.all([
      import('heic-to'),
      import('@jsquash/avif/encode'),
    ]);
    return {
      // heic-to converts HEIC blob to a JPEG/PNG blob using libheif under the hood
      heicTo: heicToModule.heicTo,
      // jSquash AVIF encoder takes ImageData and returns AVIF ArrayBuffer
      encodeAvif: avifModule.default,
    };
  }

  // Helper: convert a Blob (PNG from heic-to) into ImageData via Canvas
  // so we can hand the raw pixels to the AVIF encoder
  async function blobToImageData(blob) {
    const bitmap = await createImageBitmap(blob);
    const canvas = document.createElement('canvas');
    canvas.width = bitmap.width;
    canvas.height = bitmap.height;
    const ctx = canvas.getContext('2d');
    ctx.drawImage(bitmap, 0, 0);
    const imageData = ctx.getImageData(0, 0, bitmap.width, bitmap.height);
    bitmap.close();
    return imageData;
  }

  // Cache converted files in memory for batch download
  const convertedFiles = [];

  // DOM refs
  const dropZone = document.getElementById('dropZone');
  const dropZoneContent = document.getElementById('dropZoneContent');
  const fileInput = document.getElementById('fileInput');
  const browseBtn = document.getElementById('browseBtn');
  const qualitySlider = document.getElementById('quality');
  const qualityValue = document.getElementById('qualityValue');
  const statusArea = document.getElementById('statusArea');
  const statusLabel = document.getElementById('statusLabel');
  const statusCount = document.getElementById('statusCount');
  const progressFill = document.getElementById('progressFill');
  const results = document.getElementById('results');
  const resultList = document.getElementById('resultList');
  const downloadAllBtn = document.getElementById('downloadAllBtn');
  const clearBtn = document.getElementById('clearBtn');

  // Update quality readout
  qualitySlider.addEventListener('input', () => {
    qualityValue.textContent = qualitySlider.value;
  });

  // ——— File input triggers ———
  browseBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    fileInput.click();
  });
  dropZone.addEventListener('click', () => fileInput.click());
  dropZone.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fileInput.click(); }
  });

  fileInput.addEventListener('change', (e) => {
    handleFiles(e.target.files);
  });

  // ——— Drag and drop ———
  ['dragenter', 'dragover'].forEach(eventName => {
    dropZone.addEventListener(eventName, (e) => {
      e.preventDefault();
      e.stopPropagation();
      dropZone.classList.add('is-dragging');
    });
  });

  ['dragleave', 'drop'].forEach(eventName => {
    dropZone.addEventListener(eventName, (e) => {
      e.preventDefault();
      e.stopPropagation();
      dropZone.classList.remove('is-dragging');
    });
  });

  dropZone.addEventListener('drop', (e) => {
    const files = e.dataTransfer.files;
    handleFiles(files);
  });

  // ——— Main conversion flow ———
  async function handleFiles(fileList) {
    const heicFiles = Array.from(fileList).filter(f =>
      f.name.toLowerCase().match(/\.(heic|heif)$/i) ||
      f.type === 'image/heic' || f.type === 'image/heif'
    );

    if (heicFiles.length === 0) {
      alert('Please drop .heic or .heif files only.');
      return;
    }

    // Clear previous results
    convertedFiles.length = 0;
    resultList.innerHTML = '';
    results.hidden = true;
    downloadAllBtn.hidden = true;

    // Show status
    statusArea.hidden = false;
    statusLabel.textContent = 'Loading converter...';
    progressFill.style.width = '0%';

    // Load WASM
    const { heicTo, encodeAvif } = await loadConverters();

    const quality = parseInt(qualitySlider.value, 10);

    for (let i = 0; i < heicFiles.length; i++) {
      const file = heicFiles[i];
      statusLabel.textContent = `Converting ${file.name}...`;
      statusCount.textContent = `${i + 1} of ${heicFiles.length}`;
      progressFill.style.width = `${((i) / heicFiles.length) * 100}%`;

      try {
        const result = await convertFile(file, quality, heicTo, encodeAvif);
        convertedFiles.push(result);
        appendResult(result);
      } catch (err) {
        console.error('Conversion failed:', err);
        appendError(file.name, err.message || 'Unknown error');
      }
    }

    // Done
    progressFill.style.width = '100%';
    statusLabel.textContent = 'Done!';
    statusCount.textContent = `${convertedFiles.length} of ${heicFiles.length} converted`;

    // Brief pause to let the user see "Done!", then dismiss the overlay
    await new Promise(r => setTimeout(r, 700));
    statusArea.hidden = true;

    results.hidden = false;
    if (convertedFiles.length > 1) downloadAllBtn.hidden = false;

    // Scroll to results so user sees them immediately
    results.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  async function convertFile(file, quality, heicTo, encodeAvif) {
    // Step 1: Decode HEIC → PNG blob using libheif (via heic-to)
    // We use PNG as the intermediate format because it's lossless,
    // so we don't lose quality before re-encoding to AVIF.
    const pngBlob = await heicTo({
      blob: file,
      type: 'image/png',
    });

    // Step 2: Convert PNG blob → ImageData (raw pixel array)
    const imageData = await blobToImageData(pngBlob);

    // Step 3: Encode raw pixels → AVIF ArrayBuffer
    const avifBuffer = await encodeAvif(imageData, { quality });

    const blob = new Blob([avifBuffer], { type: 'image/avif' });
    const originalName = file.name.replace(/\.(heic|heif)$/i, '');
    const newName = `${originalName}.avif`;

    return {
      originalName: file.name,
      newName,
      blob,
      originalSize: file.size,
      newSize: blob.size,
      url: URL.createObjectURL(blob),
    };
  }

  function formatBytes(bytes) {
    if (bytes < 1024) return `${bytes} B`;
    if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
    return `${(bytes / (1024 * 1024)).toFixed(2)} MB`;
  }

  function appendResult(result) {
    const savings = Math.round((1 - result.newSize / result.originalSize) * 100);
    const isSmaller = result.newSize < result.originalSize;
    const li = document.createElement('li');
    li.className = 'result-item';
    li.innerHTML = `
      <div class="result-icon" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
          <path d="M16.5 5.5L7.5 14.5L3.5 10.5" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <div class="result-details">
        <div class="result-name">${result.newName}</div>
        <div class="result-meta">
          <span class="size-original mono">${formatBytes(result.originalSize)}</span>
          <svg class="size-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2 6h8m0 0L6.5 2.5M10 6L6.5 9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="size-new mono">${formatBytes(result.newSize)}</span>
          <span class="savings ${isSmaller ? 'savings-good' : 'savings-bad'}">
            ${isSmaller ? '−' : '+'}${Math.abs(savings)}%
          </span>
        </div>
      </div>
      <a href="${result.url}" download="${result.newName}" class="result-download" aria-label="Download ${result.newName}">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M8 1v10m0 0l-4-4m4 4l4-4M2 15h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>Download</span>
      </a>
    `;
    resultList.appendChild(li);
  }

  function appendError(filename, message) {
    const li = document.createElement('li');
    li.className = 'result-item result-item-error';
    li.innerHTML = `
      <div class="result-icon result-icon-error" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
          <path d="M10 6v4m0 4h.01M18 10a8 8 0 11-16 0 8 8 0 0116 0z" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <div class="result-details">
        <div class="result-name">${filename}</div>
        <div class="result-meta result-error-msg">${message}</div>
      </div>
    `;
    resultList.appendChild(li);
  }

  // Clear / reset
  clearBtn.addEventListener('click', () => {
    convertedFiles.forEach(r => URL.revokeObjectURL(r.url));
    convertedFiles.length = 0;
    resultList.innerHTML = '';
    results.hidden = true;
    downloadAllBtn.hidden = true;
    statusArea.hidden = true;
    progressFill.style.width = '0%';
    fileInput.value = '';
  });

  // Batch download — assembles all converted files into a real ZIP archive client-side
  downloadAllBtn.addEventListener('click', async () => {
    // Disable the button and show working state
    const originalLabel = downloadAllBtn.innerHTML;
    downloadAllBtn.disabled = true;
    downloadAllBtn.innerHTML = `
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" style="animation: spin 0.8s linear infinite;">
        <path d="M7 1a6 6 0 100 12A6 6 0 007 1zm0 2a4 4 0 014 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
      </svg>
      Building ZIP...
    `;

    try {
      // Lazy-load JSZip only when actually needed
      const { default: JSZip } = await import('jszip');
      const zip = new JSZip();

      // Add every converted file to the archive
      convertedFiles.forEach(result => {
        zip.file(result.newName, result.blob);
      });

      // Generate the zip blob (compression level 6 is a good speed/size balance)
      const zipBlob = await zip.generateAsync({
        type: 'blob',
        compression: 'DEFLATE',
        compressionOptions: { level: 6 },
      });

      // Trigger a single download
      const zipUrl = URL.createObjectURL(zipBlob);
      const a = document.createElement('a');
      a.href = zipUrl;
      a.download = `imageanvil-converted-${Date.now()}.zip`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);

      // Clean up the blob URL after a moment
      setTimeout(() => URL.revokeObjectURL(zipUrl), 1000);
    } catch (err) {
      console.error('ZIP creation failed:', err);
      alert('Sorry — failed to build the ZIP. Try downloading files individually.');
    } finally {
      downloadAllBtn.disabled = false;
      downloadAllBtn.innerHTML = originalLabel;
    }
  });
</script>

<style is:global>
  /* ========== BREADCRUMB ========== */
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-top: 2rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  .breadcrumb a { color: var(--text-muted); }
  .breadcrumb a:hover { color: var(--text-max); }
  .breadcrumb svg { opacity: 0.5; }
  .breadcrumb span[aria-current] { color: var(--text-strong); font-weight: 500; }

  /* ========== INTRO ========== */
  .tool-intro {
    padding: 3rem 0 3rem;
    text-align: center;
  }

  .tool-badges {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }
  .tool-badges svg { color: var(--text-faint); }

  .tool-intro h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 1.25rem;
  }

  .tool-lead {
    font-size: 1.125rem;
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 560px;
    margin: 0 auto;
  }

  /* ========== CONVERTER ========== */
  .converter-section { padding: 1rem 0 5rem; }

  .converter {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 2.5rem;
    box-shadow: var(--shadow-sm);
  }

  @media (max-width: 600px) {
    .converter { padding: 1.5rem; }
  }

  /* Drop zone */
  .drop-zone {
    border: 2px dashed var(--border-strong);
    border-radius: var(--radius-lg);
    padding: 3.5rem 2rem;
    text-align: center;
    cursor: pointer;
    transition: all 200ms var(--ease);
    background: var(--bg-subtle);
    position: relative;
  }
  .drop-zone:hover,
  .drop-zone:focus-visible {
    border-color: var(--glow);
    background: var(--glow-bg);
    outline: none;
  }
  .drop-zone.is-dragging {
    border-color: var(--glow);
    background: var(--glow-bg);
    box-shadow: var(--shadow-glow);
  }
  .drop-zone.is-dragging .drop-icon { transform: scale(1.1); }

  .drop-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--surface);
    color: var(--glow);
    margin-bottom: 1.25rem;
    box-shadow: var(--shadow);
    transition: transform 200ms var(--ease);
  }

  .drop-title {
    font-size: 1.25rem;
    color: var(--text-max);
    margin-bottom: 0.5rem;
  }

  .drop-sub {
    font-size: 0.9375rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .browse-btn {
    background: none;
    border: none;
    color: var(--glow);
    font-weight: 600;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
    font-size: inherit;
    font-family: inherit;
    padding: 0;
  }
  .browse-btn:hover { color: #ea580c; }

  .drop-note {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Settings */
  .settings {
    margin-top: 1.75rem;
    padding: 1.5rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .setting label {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-strong);
    margin-bottom: 0.75rem;
  }

  .quality-row {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .quality-row input[type="range"] {
    flex: 1;
    -webkit-appearance: none;
    appearance: none;
    height: 4px;
    background: var(--border-strong);
    border-radius: 2px;
    outline: none;
  }
  .quality-row input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 20px;
    height: 20px;
    background: var(--glow);
    border: 2px solid white;
    border-radius: 50%;
    cursor: pointer;
    box-shadow: var(--shadow);
    transition: transform 150ms;
  }
  .quality-row input[type="range"]::-webkit-slider-thumb:hover { transform: scale(1.1); }
  .quality-row input[type="range"]::-moz-range-thumb {
    width: 20px;
    height: 20px;
    background: var(--glow);
    border: 2px solid white;
    border-radius: 50%;
    cursor: pointer;
    box-shadow: var(--shadow);
  }

  .quality-row output {
    font-weight: 600;
    font-size: 1rem;
    color: var(--text-max);
    min-width: 2ch;
    text-align: center;
    padding: 0.25rem 0.75rem;
    background: var(--surface);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
  }

  .setting-hint {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin-top: 0.75rem;
    line-height: 1.5;
  }
  .setting-hint strong { color: var(--text-strong); font-weight: 600; }

  /* ========== STATUS OVERLAY (MODAL) ========== */
  .status-overlay[hidden] { display: none !important; }

  .status-overlay {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    animation: overlayFadeIn 250ms var(--ease);
  }

  @keyframes overlayFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .status-modal {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 2.5rem 2rem;
    box-shadow: 0 20px 60px rgba(15, 23, 42, 0.3);
    width: 100%;
    max-width: 440px;
    text-align: center;
    animation: modalIn 350ms var(--ease);
  }

  @keyframes modalIn {
    from { opacity: 0; transform: translateY(20px) scale(0.96); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  /* The forge animation — anvil with pixels rising and a glow */
  .forge-animation {
    position: relative;
    width: 140px;
    height: 140px;
    margin: 0 auto 2rem;
