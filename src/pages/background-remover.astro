---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Background Remover — Free, Private, No Uploads"
  description="Remove image backgrounds for free, right in your browser. AI-powered cutouts with transparent PNG, WebP, or solid-color output. No uploads, no account, no watermark."
>
  <nav class="breadcrumb container" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M4 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <span aria-current="page">Background Remover</span>
  </nav>

  <section class="tool-intro">
    <div class="container-narrow">
      <div class="tool-badges">
        <span class="badge">Any photo</span>
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 7h12m0 0L7.5 1.5M13 7l-5.5 5.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span class="badge badge-glow">Transparent PNG</span>
      </div>
      <h1>Background Remover</h1>
      <p class="tool-lead">Drop a photo and get a clean cutout in seconds. The AI model runs on your own device, so your images are never uploaded anywhere. No account, no watermark, full resolution.</p>
    </div>
  </section>

  <section class="converter-section">
    <div class="container-narrow">
      <div class="converter" id="converter">
        <p class="engine-note" id="engineNote" data-state="checking">
          <span class="engine-dot" aria-hidden="true"></span>
          <span id="engineText">Checking what your device can do…</span>
        </p>

        <div class="drop-zone" id="dropZone" role="button" tabindex="0" aria-label="Drop image files or click to browse">
          <input type="file" id="fileInput" accept="image/jpeg,image/png,image/webp,image/avif,image/heic,image/heif,.jpg,.jpeg,.png,.webp,.avif,.heic,.heif" multiple hidden />
          <div class="drop-zone-content">
            <div class="drop-icon"><svg width="48" height="48" viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M24 6v28m0 0l-10-10m10 10l10-10M8 42h32" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
            <h3 class="drop-title">Drop images here</h3>
            <p class="drop-sub">or <button type="button" class="browse-btn" id="browseBtn">browse to choose</button></p>
            <p class="drop-note">JPG, PNG, WebP, AVIF, HEIC · Multiple files supported</p>
          </div>
        </div>

        <div class="settings" id="settings">
          <div class="setting">
            <label id="bgLabel">Background</label>
            <div class="format-selector" role="radiogroup" aria-labelledby="bgLabel">
              <label class="format-option"><input type="radio" name="bgMode" value="transparent" checked /><span class="format-pill-btn"><span class="swatch swatch-checker" aria-hidden="true"></span>Transparent</span></label>
              <label class="format-option"><input type="radio" name="bgMode" value="white" /><span class="format-pill-btn"><span class="swatch" style="background:#fff" aria-hidden="true"></span>White</span></label>
              <label class="format-option"><input type="radio" name="bgMode" value="custom" /><span class="format-pill-btn"><span class="swatch" id="customSwatch" style="background:#0f172a" aria-hidden="true"></span>Color</span></label>
              <input type="color" id="bgColor" value="#0f172a" class="color-input" aria-label="Custom background color" />
            </div>
          </div>
          <div class="setting">
            <label id="fmtLabel">Download as</label>
            <div class="format-selector" role="radiogroup" aria-labelledby="fmtLabel">
              <label class="format-option"><input type="radio" name="outputFormat" value="png" checked /><span class="format-pill-btn">PNG</span></label>
              <label class="format-option"><input type="radio" name="outputFormat" value="webp" /><span class="format-pill-btn">WebP</span></label>
              <label class="format-option" id="jpgOption"><input type="radio" name="outputFormat" value="jpeg" disabled /><span class="format-pill-btn">JPG</span></label>
            </div>
            <p class="setting-hint" id="formatHint"><strong>PNG</strong> keeps transparency everywhere. <strong>WebP</strong> is much smaller for websites. JPG needs a solid background.</p>
          </div>
        </div>

        <div class="status-overlay" id="statusArea" hidden role="dialog" aria-modal="true" aria-labelledby="statusLabel" aria-live="polite">
          <div class="status-modal">
            <div class="forge-animation" aria-hidden="true">
              <div class="forge-anvil"><svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg"><path d="M 35 80 L 165 80 L 175 95 L 165 110 L 125 110 L 125 140 L 155 140 L 155 160 L 45 160 L 45 140 L 75 140 L 75 110 L 35 110 Z" fill="currentColor"/></svg></div>
              <div class="forge-pixels"><span class="forge-pixel forge-pixel-1"></span><span class="forge-pixel forge-pixel-2"></span><span class="forge-pixel forge-pixel-3"></span><span class="forge-pixel forge-pixel-4"></span><span class="forge-pixel forge-pixel-5"></span></div>
              <div class="forge-glow-bg" aria-hidden="true"></div>
            </div>
            <div class="status-content"><span class="status-label" id="statusLabel">Preparing...</span><span class="status-count" id="statusCount"></span></div>
            <div class="progress-bar"><div class="progress-fill" id="progressFill"></div></div>
            <p class="status-note" id="statusNote">Everything happens in your browser. Don't close this tab.</p>
          </div>
        </div>

        <div class="results" id="results" hidden>
          <div class="results-header"><h3>Background removed</h3><button type="button" class="btn-text" id="clearBtn">Clear</button></div>
          <ul class="cut-list" id="resultList"></ul>
          <button type="button" class="btn btn-primary download-all" id="downloadAllBtn" hidden>
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M7 1v9m0 0l-4-4m4 4l4-4M2 13h10" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Download all as ZIP
          </button>
        </div>
      </div>
    </div>
  </section>

  <section class="info-section">
    <div class="container-narrow">
      <h2>How it works</h2>
      <p>Image Anvil uses <strong>BiRefNet</strong>, an open-source AI segmentation model, to figure out which pixels belong to your subject and which belong to the background. Instead of a hard yes/no for every pixel, it produces a soft mask, which is why edges like hair and fabric come out smooth instead of jagged.</p>
      <p>The model runs inside your browser using WebGPU when your device supports it, and falls back to your CPU when it doesn't. The first time you use the tool, your browser downloads the model once (about 115 MB on most devices). After that it's cached, so later visits start almost instantly.</p>

      <h3>Tips for the cleanest cutouts</h3>
      <ul class="info-list">
        <li><strong>Contrast helps.</strong> A subject that stands out from its background gives the model the easiest job.</li>
        <li><strong>Keep the subject in frame.</strong> Products, people, and pets that aren't cropped at the edges cut out best.</li>
        <li><strong>Thin and see-through things are hardest.</strong> Cables, glass, smoke, and very fine flyaway hair may need a touch-up in an editor.</li>
        <li><strong>Product photos for a store?</strong> Pick the White background and WebP or JPG for a clean, catalog-ready image at a fraction of the file size.</li>
      </ul>

      <h3>Is this really private?</h3>
      <p>Yes. Your images are processed in your browser tab and never sent to a server. The only downloads are the AI model (from Hugging Face) and the code that runs it (from jsDelivr), which are the same public files for every visitor. If you're curious, open your browser's network tab while you use the tool: you'll see the model download, and no image upload.</p>

      <h3>Looking for a remove.bg alternative?</h3>
      <p>remove.bg is closing its standalone website on December 1, 2026. If you used it for quick cutouts, this tool covers the same everyday job for free, without an account. <a href="/blog/remove-bg-alternative">Here's what's changing and how the options compare.</a></p>
    </div>
  </section>
</BaseLayout>

<script>
  import { detectEngine, getSession, getActivePlan, isModelCached, removeBackground, MODELS } from '../lib/bg-remover.js';

  const results = [];
  const $ = (id) => document.getElementById(id);
  const dropZone = $('dropZone');
  const fileInput = $('fileInput');
  const statusArea = $('statusArea');
  const statusLabel = $('statusLabel');
  const statusCount = $('statusCount');
  const statusNote = $('statusNote');
  const progressFill = $('progressFill');
  const resultsEl = $('results');
  const resultList = $('resultList');
  const downloadAllBtn = $('downloadAllBtn');
  const engineNote = $('engineNote');
  const engineText = $('engineText');
  const bgColor = $('bgColor');
  const customSwatch = $('customSwatch');
  const jpgInput = document.querySelector('input[name="outputFormat"][value="jpeg"]');
  const jpgOption = $('jpgOption');

  // ——— Device check ——————————————————————————————————————
  (async () => {
    const plan = await detectEngine();
    const cached = await isModelCached(plan);
    const mb = Math.round(MODELS[plan.precision].approxBytes / 1e6);
    if (plan.ep === 'webgpu') {
      engineNote.dataset.state = 'fast';
      engineText.innerHTML = cached
        ? '<strong>GPU-accelerated</strong> · model already cached, ready to go.'
        : `<strong>GPU-accelerated</strong> on this device. First use downloads a one-time ${mb} MB model.`;
    } else {
      engineNote.dataset.state = 'slow';
      engineText.innerHTML = `<strong>CPU mode:</strong> your browser doesn't support WebGPU, so expect 30–90 seconds per image${cached ? '' : ` and a one-time ${mb} MB download`}. Chrome or Edge is much faster.`;
    }
  })();

  // ——— Settings ————————————————————————————————————————
  const getFormat = () => document.querySelector('input[name="outputFormat"]:checked').value;
  const getBgMode = () => document.querySelector('input[name="bgMode"]:checked').value;
  function getFill() {
    const mode = getBgMode();
    if (mode === 'white') return '#ffffff';
    if (mode === 'custom') return bgColor.value;
    return null;
  }

  function syncSettings() {
    const fill = getFill();
    customSwatch.style.background = bgColor.value;
    jpgInput.disabled = !fill;
    jpgOption.classList.toggle('is-disabled', !fill);
    if (!fill && getFormat() === 'jpeg') document.querySelector('input[name="outputFormat"][value="png"]').checked = true;
    // Live-update previews so the user sees the background they'll get
    resultList.style.setProperty('--fill', fill || 'transparent');
    resultList.classList.toggle('has-fill', !!fill);
  }
  document.querySelectorAll('input[name="bgMode"], input[name="outputFormat"]').forEach((r) => r.addEventListener('change', syncSettings));
  bgColor.addEventListener('input', () => { document.querySelector('input[name="bgMode"][value="custom"]').checked = true; syncSettings(); });
  syncSettings();

  // ——— File input ——————————————————————————————————————
  $('browseBtn').addEventListener('click', (e) => { e.stopPropagation(); fileInput.click(); });
  dropZone.addEventListener('click', () => fileInput.click());
  dropZone.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fileInput.click(); } });
  fileInput.addEventListener('change', (e) => handleFiles(e.target.files));
  ['dragenter', 'dragover'].forEach((ev) => dropZone.addEventListener(ev, (e) => { e.preventDefault(); e.stopPropagation(); dropZone.classList.add('is-dragging'); }));
  ['dragleave', 'drop'].forEach((ev) => dropZone.addEventListener(ev, (e) => { e.preventDefault(); e.stopPropagation(); dropZone.classList.remove('is-dragging'); }));
  dropZone.addEventListener('drop', (e) => handleFiles(e.dataTransfer.files));

  const isHeic = (f) => /heic|heif/i.test(f.type) || /\.(heic|heif)$/i.test(f.name);

  async function fileToBitmap(file) {
    if (isHeic(file)) {
      const { heicTo } = await import('heic-to');
      const png = await heicTo({ blob: file, type: 'image/png' });
      return createImageBitmap(png);
    }
    return createImageBitmap(file);
  }

  function formatMB(bytes) { return (bytes / 1e6).toFixed(0); }

  function onModelProgress(p) {
    if (p.phase === 'init') {
      statusLabel.textContent = 'Warming up the model…';
      statusCount.textContent = '';
      statusNote.textContent = 'Getting the AI ready. This only takes long the first time.';
      progressFill.style.width = '100%';
      return;
    }
    if (p.cached) return;
    const pct = Math.min(100, (p.loaded / p.total) * 100);
    statusLabel.textContent = 'Downloading AI model…';
    statusCount.textContent = `${formatMB(p.loaded)} of ${formatMB(p.total)} MB`;
    statusNote.textContent = 'One-time download. Next time it loads from your browser cache.';
    progressFill.style.width = `${pct}%`;
  }

  async function handleFiles(fileList) {
    const files = Array.from(fileList).filter((f) => f.type.startsWith('image/') || isHeic(f));
    if (!files.length) { alert('Please drop image files.'); return; }

    statusArea.hidden = false;
    statusLabel.textContent = 'Loading AI engine…';
    statusCount.textContent = '';
    progressFill.style.width = '0%';

    try {
      await getSession(onModelProgress);
    } catch (err) {
      console.error('Model load failed:', err);
      statusArea.hidden = true;
      resultsEl.hidden = false;
      appendError('AI model', `Couldn't load the background removal model (${err.message || 'unknown error'}). Check your connection and try again.`);
      return;
    }

    const plan = getActivePlan();
    statusNote.textContent = plan?.ep === 'webgpu'
      ? 'Running on your GPU. Your images never leave this device.'
      : 'Running on your CPU. This can take a minute per image. Your images never leave this device.';

    for (let i = 0; i < files.length; i++) {
      const file = files[i];
      statusLabel.textContent = `Removing background…`;
      statusCount.textContent = `${file.name} · ${i + 1} of ${files.length}`;
      progressFill.style.width = `${(i / files.length) * 100}%`;
      // Give the browser a frame to paint the status before heavy work
      await new Promise((r) => requestAnimationFrame(() => setTimeout(r, 30)));
      try {
        const bitmap = await fileToBitmap(file);
        const { cutout, width, height } = await removeBackground(bitmap);
        const result = { name: file.name, cutout, width, height, original: previewCanvas(bitmap, width, height) };
        bitmap.close?.();
        results.push(result);
        appendResult(result);
        resultsEl.hidden = false;
      } catch (err) {
        console.error('Background removal failed:', err);
        resultsEl.hidden = false;
        appendError(file.name, err.message || 'Unknown error');
      }
    }

    progressFill.style.width = '100%';
    statusLabel.textContent = 'Done!';
    await new Promise((r) => setTimeout(r, 500));
    statusArea.hidden = true;
    downloadAllBtn.hidden = results.length < 2;
    fileInput.value = '';
    resultList.lastElementChild?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  // ——— Previews ————————————————————————————————————————
  const PREVIEW_MAX = 1400;
  function previewCanvas(source, w, h) {
    const s = Math.min(1, PREVIEW_MAX / Math.max(w, h));
    const c = document.createElement('canvas');
    c.width = Math.round(w * s); c.height = Math.round(h * s);
    const ctx = c.getContext('2d');
    ctx.imageSmoothingQuality = 'high';
    ctx.drawImage(source, 0, 0, c.width, c.height);
    return c;
  }

  function appendResult(r) {
    const li = document.createElement('li');
    li.className = 'cut-item';
    li.innerHTML = `
      <div class="compare" style="--ratio:${r.width / r.height}; --pos:50%">
        <div class="compare-layer compare-before"></div>
        <div class="compare-layer compare-after"></div>
        <div class="compare-handle" aria-hidden="true"><span class="compare-knob"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M5.5 4L2 8l3.5 4M10.5 4L14 8l-3.5 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></span></div>
        <span class="compare-tag compare-tag-before">Before</span>
        <span class="compare-tag compare-tag-after">After</span>
        <input type="range" class="compare-range" min="0" max="100" value="50" aria-label="Drag to compare before and after" />
      </div>
      <div class="cut-footer">
        <div class="result-details">
          <div class="result-name"></div>
          <div class="result-meta"><span class="mono">${r.width} × ${r.height}</span></div>
        </div>
        <button type="button" class="result-download">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 1v10m0 0l-4-4m4 4l4-4M2 15h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>Download</span>
        </button>
      </div>`;
    li.querySelector('.result-name').textContent = outputName(r.name, getFormat());
    li.querySelector('.compare-before').appendChild(r.original);
    li.querySelector('.compare-after').appendChild(previewCanvas(r.cutout, r.width, r.height));
    const compare = li.querySelector('.compare');
    li.querySelector('.compare-range').addEventListener('input', (e) => compare.style.setProperty('--pos', `${e.target.value}%`));
    const btn = li.querySelector('.result-download');
    btn.addEventListener('click', () => downloadOne(r, btn));
    r.nameEl = li.querySelector('.result-name');
    resultList.appendChild(li);
  }

  // Keep displayed filenames in sync with the chosen format
  document.querySelectorAll('input[name="outputFormat"], input[name="bgMode"]').forEach((el) =>
    el.addEventListener('change', () => results.forEach((r) => { if (r.nameEl) r.nameEl.textContent = outputName(r.name, getFormat()); })));

  function appendError(filename, message) {
    const li = document.createElement('li');
    li.className = 'result-item result-item-error';
    li.innerHTML = `
      <div class="result-icon result-icon-error" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 6v4m0 4h.01M18 10a8 8 0 11-16 0 8 8 0 0116 0z" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
      <div class="result-details"><div class="result-name"></div><div class="result-meta result-error-msg"></div></div>`;
    li.querySelector('.result-name').textContent = filename;
    li.querySelector('.result-error-msg').textContent = message;
    resultList.appendChild(li);
  }

  // ——— Export ——————————————————————————————————————————
  const EXT = { png: 'png', webp: 'webp', jpeg: 'jpg' };
  function outputName(name, fmt) { return `${name.replace(/\.[^.]+$/, '')}-no-bg.${EXT[fmt]}`; }

  function canvasToBlob(canvas, type, quality) {
    return new Promise((resolve, reject) => canvas.toBlob((b) => (b ? resolve(b) : reject(new Error('Export failed'))), type, quality));
  }

  async function encodeResult(r) {
    const fmt = getFormat();
    const fill = getFill();
    let canvas = r.cutout;
    if (fill) {
      canvas = document.createElement('canvas');
      canvas.width = r.width; canvas.height = r.height;
      const ctx = canvas.getContext('2d');
      ctx.fillStyle = fill;
      ctx.fillRect(0, 0, r.width, r.height);
      ctx.drawImage(r.cutout, 0, 0);
    }
    let blob;
    if (fmt === 'webp') {
      // jSquash, because Safari's canvas can't encode WebP
      const { default: encode } = await import('@jsquash/webp/encode');
      const data = canvas.getContext('2d').getImageData(0, 0, r.width, r.height);
      blob = new Blob([await encode(data, { quality: 90 })], { type: 'image/webp' });
    } else if (fmt === 'jpeg') {
      blob = await canvasToBlob(canvas, 'image/jpeg', 0.92);
    } else {
      blob = await canvasToBlob(canvas, 'image/png');
    }
    return { blob, name: outputName(r.name, fmt) };
  }

  function triggerDownload(blob, name) {
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = name;
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 1500);
  }

  async function downloadOne(r, btn) {
    const label = btn.querySelector('span');
    btn.disabled = true; label.textContent = 'Saving…';
    try { const { blob, name } = await encodeResult(r); triggerDownload(blob, name); }
    catch (err) { console.error(err); alert('Export failed. Try PNG instead.'); }
    finally { btn.disabled = false; label.textContent = 'Download'; }
  }

  downloadAllBtn.addEventListener('click', async () => {
    const original = downloadAllBtn.innerHTML;
    downloadAllBtn.disabled = true;
    downloadAllBtn.textContent = 'Building ZIP…';
    try {
      const { default: JSZip } = await import('jszip');
      const zip = new JSZip();
      for (const r of results) { const { blob, name } = await encodeResult(r); zip.file(name, blob); }
      const zipBlob = await zip.generateAsync({ type: 'blob', compression: 'STORE' });
      triggerDownload(zipBlob, `imageanvil-cutouts-${Date.now()}.zip`);
    } catch (err) { console.error('ZIP failed:', err); alert('Failed to build ZIP. Try downloading individually.'); }
    finally { downloadAllBtn.disabled = false; downloadAllBtn.innerHTML = original; }
  });

  $('clearBtn').addEventListener('click', () => {
    results.length = 0;
    resultList.innerHTML = '';
    resultsEl.hidden = true;
    downloadAllBtn.hidden = true;
    fileInput.value = '';
  });
</script>

<style is:global>
  /* ——— Shared tool styles (same as the converter pages) ——— */
  .breadcrumb { display: flex; align-items: center; gap: 0.5rem; padding-top: 2rem; font-size: 0.875rem; color: var(--text-muted); }
  .breadcrumb a { color: var(--text-muted); } .breadcrumb a:hover { color: var(--text-max); }
  .breadcrumb svg { opacity: 0.5; } .breadcrumb span[aria-current] { color: var(--text-strong); font-weight: 500; }
  .tool-intro { padding: 3rem 0; text-align: center; }
  .tool-badges { display: inline-flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem; }
  .tool-badges svg { color: var(--text-faint); }
  .tool-intro h1 { font-size: clamp(2rem, 4vw, 3rem); margin-bottom: 1.25rem; }
  .tool-lead { font-size: 1.125rem; color: var(--text-muted); line-height: 1.6; max-width: 560px; margin: 0 auto; }
  .converter-section { padding: 1rem 0 5rem; }
  .converter { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-xl); padding: 2.5rem; box-shadow: var(--shadow-sm); }
  @media (max-width: 600px) { .converter { padding: 1.5rem; } }
  .drop-zone { border: 2px dashed var(--border-strong); border-radius: var(--radius-lg); padding: 3.5rem 2rem; text-align: center; cursor: pointer; transition: all 200ms var(--ease); background: var(--bg-subtle); }
  .drop-zone:hover, .drop-zone:focus-visible { border-color: var(--glow); background: var(--glow-bg); outline: none; }
  .drop-zone.is-dragging { border-color: var(--glow); background: var(--glow-bg); box-shadow: var(--shadow-glow); }
  .drop-icon { display: inline-flex; align-items: center; justify-content: center; width: 72px; height: 72px; border-radius: 50%; background: var(--surface); color: var(--glow); margin-bottom: 1.25rem; box-shadow: var(--shadow); transition: transform 200ms var(--ease); }
  .drop-title { font-size: 1.25rem; color: var(--text-max); margin-bottom: 0.5rem; }
  .drop-sub { font-size: 0.9375rem; color: var(--text-muted); margin-bottom: 0.75rem; }
  .browse-btn { background: none; border: none; color: var(--glow); font-weight: 600; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; font-size: inherit; font-family: inherit; padding: 0; }
  .browse-btn:hover { color: #ea580c; }
  .drop-note { font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-faint); text-transform: uppercase; letter-spacing: 0.05em; }
  .settings { margin-top: 1.75rem; padding: 1.5rem; background: var(--bg-subtle); border: 1px solid var(--border); border-radius: var(--radius); }
  .setting label { display: block; font-size: 0.875rem; font-weight: 600; color: var(--text-strong); margin-bottom: 0.75rem; }
  .format-selector { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.25rem; }
